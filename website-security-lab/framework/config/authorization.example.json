{
  "authorization": {
    "id": "AUTH-2026-0912-001",
    "owner": "某单位网络安全负责人",
    "valid_from": "2026-09-01",
    "valid_until": "2026-12-31",
    "document": "evidence/auth-2026-0912.pdf"
  },
  "scope": {
    "domains": ["portal.example.gov.cn", "*.example.gov.cn"],
    "ip_ranges": ["203.0.113.0/24"],
    "url_prefixes": ["https://portal.example.gov.cn/"],
    "exclude": {
      "paths": ["/admin/export", "/api/personal"],
      "patterns": ["*?download=*"]
    },
    "max_depth": 2,
    "max_concurrency": 4,
    "max_requests_per_run": 500,
    "follow_redirects_offsite": false
  },
  "schedule": {
    "cron": "0 2 * * *",
    "window": "00:00-23:59",
    "freeze_dates": []
  },
  "rate_limit": {
    "per_domain_qps": 5,
    "global_qps": 20,
    "user_agent": "SecurityInspector/1.0 (+authorized-scan; contact=secops@example.gov.cn)"
  },
  "safety": {
    "default_tier": "T0",
    "active_assets": ["portal.example.gov.cn"],
    "allow_active_tier": [],
    "deny_actions": ["bruteforce", "sqli_dump", "file_upload", "dos"]
  },
  "trusted_domains": ["www.example.com", "cdn.example.com"],
  "asset_criticality": {
    "portal.example.gov.cn": 0.9
  },
  "sensitive_rules": {
    "keywords": ["内部资料", "仅供内部使用"],
    "regex": [
      {
        "name": "中国大陆手机号",
        "pattern": "(?<!\\d)1[3-9]\\d{9}(?!\\d)"
      },
      {
        "name": "身份证号",
        "pattern": "[1-9]\\d{5}(19|20)\\d{2}(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01])\\d{3}[\\dXx]"
      },
      {
        "name": "AccessKeyId",
        "pattern": "(?i)(access[-_]?key[-_]?id)\\s*[=:]\\s*[A-Za-z0-9]{16,}"
      }
    ],
    "file_types": ["csv", "sql", "bak", "env", "log", "pdf", "xlsx"],
    "samples": ["PROJECT-INTERNAL-ONLY-2026"],
    "whitelist": ["13800000000"],
    "masking": "partial"
  },
  "notify": {
    "channels": [
      {"type": "email", "to": ["secops@example.gov.cn"], "min_level": "P1"}
    ],
    "quiet_hours": "22:00-07:00"
  }
}
